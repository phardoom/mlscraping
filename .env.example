# Copie para .env e ajuste se necessário

# Execução
ML_HEADLESS=true
ML_MAX_ITEMS=50
ML_RATE_LIMIT_MS=800
ML_NAV_TIMEOUT_MS=30000

# Paths
ML_OUT_DIR=data/out
ML_IMAGES_DIR=data/images
ML_STATE_PATH=data/state/storage_state.json
ML_DB_PATH=data/app.db

# Afiliado (MVP sem programa específico)
ML_AFFILIATE__STRATEGY=none
ML_AFFILIATE__UTM_SOURCE=whatsapp
ML_AFFILIATE__UTM_MEDIUM=group
ML_AFFILIATE__UTM_CAMPAIGN_PREFIX=ofertas_

